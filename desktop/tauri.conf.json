{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiaro Unlimited-OCR",
  "version": "0.5.1",
  "identifier": "io.github.kiarosama.unlimited-ocr",
  "build": { "frontendDist": "web/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Kiaro Unlimited-OCR", "width": 1440, "height": 920, "minWidth": 880, "minHeight": 640, "visible": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false, "publisher": "KiaroSama", "copyright": "Copyright 2026 KiaroSama", "shortDescription": "Local CUDA document workspace" }
}
